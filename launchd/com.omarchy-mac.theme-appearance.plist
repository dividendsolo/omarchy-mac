<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.omarchy-mac.theme-appearance</string>
  <!-- Resident listener for AppleInterfaceThemeChangedNotification — reacts
       instantly to light/dark flips (replaces the old 15s poll). Source:
       dotfiles/bin/theme-appearance-listener.swift -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/.local/bin/theme-appearance-listener</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/theme-appearance.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/theme-appearance.log</string>
</dict>
</plist>
